{
  "name": "phone-monitor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "desktop",
    "dashboard"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "node scripts/workspace.mjs verify",
    "doctor": "node scripts/workspace.mjs doctor",
    "connect": "node scripts/workspace.mjs connect",
    "install-hub": "node scripts/workspace.mjs install-hub",
    "uninstall-hub": "node scripts/workspace.mjs uninstall-hub",
    "claude-install": "node scripts/workspace.mjs claude-install",
    "claude-uninstall": "node scripts/workspace.mjs claude-uninstall",
    "package": "node scripts/workspace.mjs package"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
