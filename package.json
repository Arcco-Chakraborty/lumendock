{
  "name": "phone-monitor",
  "version": "1.3.1",
  "description": "Turn a spare Android phone into a USB desk display for Claude/Codex limits, laptop notifications, media keys and an ESP32 lamp.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "desktop",
    "dashboard"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @phone-monitor/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "node scripts/workspace.mjs verify",
    "doctor": "node scripts/workspace.mjs doctor",
    "connect": "node scripts/workspace.mjs connect",
    "install-hub": "node scripts/workspace.mjs install-hub",
    "uninstall-hub": "node scripts/workspace.mjs uninstall-hub",
    "claude-install": "node scripts/workspace.mjs claude-install",
    "claude-usage": "npm run start --silent --workspace @phone-monitor/desktop -- claude-usage",
    "package": "node scripts/workspace.mjs package",
    "service:start": "./scripts/phone-monitor.sh start",
    "service:stop": "./scripts/phone-monitor.sh stop",
    "service:status": "./scripts/phone-monitor.sh status",
    "service:logs": "./scripts/phone-monitor.sh logs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
