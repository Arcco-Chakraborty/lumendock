    "dev": "vite --host 127.0.0.1",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@phone-monitor/protocol": "1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
