{
  "name": "@phone-monitor/dashboard",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
